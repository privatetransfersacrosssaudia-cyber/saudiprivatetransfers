# =============================================================================
# Private Transfers Across Saudi — environment template
# =============================================================================
# Copy to `.env.local` for development and fill in real values. Never commit a
# filled-in file: `.gitignore` covers `.env*` and makes a single exception for
# this template, which must stay valueless.
#
# In production every one of these is set in the hosting dashboard
# (Cloudflare → Workers & Pages → Settings → Variables and Secrets), not in a
# file. `wrangler.jsonc` sets `keep_vars: true`, so a deploy will not wipe
# dashboard-set values.
#
# Nothing here is prefixed `NEXT_PUBLIC_` except the site URL. That prefix is
# the only thing that puts a value into the browser bundle, so a secret must
# never carry it.
# =============================================================================


# --- Public site -------------------------------------------------------------

# The canonical origin, no trailing slash. Drives canonical URLs, hreflang,
# the sitemap, Open Graph tags, JSON-LD and the links inside CRM emails.
# Local QA sets this to http://localhost:3000.
# Production: https://privatetransfersacrosssaudia.com
NEXT_PUBLIC_SITE_URL=


# --- Database (Supabase) -----------------------------------------------------
#
# Create a NEW, EMPTY Supabase project for this site, then run
# `supabase/schema.sql` in its SQL editor. Do not point these at any other
# project's database.

# Project URL, e.g. https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# The SERVICE ROLE key — not the anon key.
#
# It bypasses Row Level Security completely, which is why every table in
# schema.sql has RLS on with no policies: the service role is the only way in,
# and it is only ever used server-side. Treat this exactly like a database
# password. If it leaks, rotate it in the Supabase dashboard immediately.
SUPABASE_SERVICE_ROLE_KEY=


# --- CRM sessions ------------------------------------------------------------

# Signs the CRM session cookie (HS256). At least 32 characters; longer is
# better. There is deliberately no fallback — if this is unset, nobody can sign
# in, which is the safe failure.
#
# Generate one with:  openssl rand -base64 48
#
# Changing it signs everyone out, which is also how you revoke every session at
# once if you suspect a cookie has been captured.
CRM_SESSION_SECRET=


# --- Email (Resend) ----------------------------------------------------------
#
# Sending is optional: an enquiry is always stored first, and email failures
# never lose it. Every attempt — sent, failed or skipped — is written to the
# `email_logs` table and shown on the enquiry's own screen.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# The From address.
#
# ⚠ Its DOMAIN must be verified with Resend before anything will send. Adding
# a mailbox is not the same thing: verification means adding the DKIM, SPF and
# return-path DNS records Resend gives you, on the domain used here, and
# waiting for it to show as verified. Until then every send is rejected and
# logged as failed.
#
# Use the published bookings address, so the From a customer sees matches the
# one printed in the contact bar and in lib/site.ts:
#   Private Transfers Across Saudi <booking@privatetransfersacrosssaudia.com>
# Note "booking", singular — an earlier value used "bookings" and they are
# different mailboxes.
# Format: either "name@domain" or "Display Name <name@domain>"
CRM_EMAIL_FROM=

# Who is told when a new enquiry arrives. Comma-separated for several people.
# Without it, enquiries are still stored — nobody is notified by email.
CRM_EMAIL_NOTIFY=

# Optional. Where customer replies should go, when the From address above is
# not a mailbox anybody reads — which is the normal case, because a domain
# verified for *sending* does not automatically receive anything.
#
# Left blank, this falls back to the contact address published in lib/site.ts,
# so replies always reach somewhere. Set it here once a monitored mailbox
# exists on the domain, and it takes precedence.
CRM_EMAIL_REPLY_TO=
